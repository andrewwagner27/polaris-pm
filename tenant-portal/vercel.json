{
  "functions": {
    "api/classify-and-route.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/daily-recap",
      "schedule": "0 12 * * *"
    }
  ]
}
