# Copy this file to .env and fill in values. .env is gitignored — never commit it.
#
# STRIPE_SECRET_KEY: restricted test key (sk_test_...) from Stripe Dashboard.
#   Permissions needed: payment_intents:write, customers:read, payment_methods:read, accounts:read
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# STRIPE_WEBHOOK_SECRET: signing secret for the platform ("Your account") endpoint.
#   Printed by `stripe listen` at startup. Changes each session.
#   Run: stripe listen --forward-to http://localhost:54321/functions/v1/stripe-webhook
#   Production: Stripe Dashboard → Developers → Webhooks → platform endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# STRIPE_CONNECT_WEBHOOK_SECRET: signing secret for the connected-accounts endpoint.
#   Local testing: stripe listen --forward-to ... --connect (separate invocation)
#   Production: Stripe Dashboard → Developers → Webhooks → connected-accounts endpoint → Signing secret
#   These are TWO separate endpoints with two separate whsec_ values.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_ME
