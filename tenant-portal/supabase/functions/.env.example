# Copy this file to .env and fill in values. .env is gitignored — never commit it.
#
# STRIPE_SECRET_KEY: restricted test key (sk_test_...) from Stripe Dashboard.
#   Permissions needed: payment_intents:write, customers:read, payment_methods:read, accounts:read
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# STRIPE_WEBHOOK_SECRET: printed by `stripe listen` at startup. Changes each session.
#   Run: stripe listen --forward-to http://localhost:54321/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
